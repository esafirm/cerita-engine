      "text": {
        "id": "Jam dua belas kurang dua puluh. HP Sekar bunyi. Nomor pribadi.",
        "en": "Twenty to midnight. Sekar's phone rings. A private number."
      }
    },
    {
      "type": "NARRATION",
      "text": {
        "id": "Nggak ada suara. Cuma ombak. Ombak yang pecah pelan di sesuatu yang deket. Dan di belakangnya, mesin. Bukan mesin kapal. Genset.",
        "en": "No voice. Just waves. Waves breaking softly against something close. And behind them, an engine. Not a boat engine. A generator."
      }
    },
    {
      "type": "TEXT",
      "text": {
        "id": "Halo?",
        "en": "Hello?"
      },
      "profile": "player"
    },
    {
      "type": "NARRATION",
      "text": {
        "id": "Ombak. Genset. Nggak ada yang ngomong.",
        "en": "Waves. The generator. Nobody speaks."
      }
    },
    {
      "type": "TEXT",
      "text": {
        "id": "Kar?",
        "en": "Kar?"
      },
      "profile": "player"
    },
