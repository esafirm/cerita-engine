sekar typing=2.4s sfx=sfx_msg_receive.mp3
  id: gue nggak marah
  en: i'm not mad
sekar typing=3.1s sfx=sfx_msg_receive.mp3
  id: ok gue marah. tapi lebih ke capek
  en: ok i'm angry. but mostly tired
sekar typing=3.8s sfx=sfx_msg_receive.mp3
