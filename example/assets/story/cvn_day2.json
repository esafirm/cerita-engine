  "conversations": [
    { "type": "NARRATION", "text": "Day 2, 9:15 AM. The café from the photo. Nora insisted on coming along." },
    {
      "type": "TEXT",
      "text": "So this is the place? It looks exactly like the picture.",
      "profile": "123aaa:0",
      "position": "left"
    },
    {
      "type": "TEXT",
      "condition": "PLAN == 'knows_cafe'",
      "text": "Good thing you knew the way. I'd still be wandering down 5th street.",
      "profile": "123aaa:2"
    },
    {
      "type": "NARRATION",
      "condition": "heard_story == true",
      "text": "Miki's voice from last night is still in your head. {i}We met at that café in 2019.{/i}"
    },
    { "type": "SET", "effects": [{ "variable": "greeting", "op": "set", "expr": "random(1, 2)" }] },
    {
      "type": "TEXT",
      "condition": "greeting == 1",
      "text": "You must be the one Miki wrote about.",
      "profile": "123ccc:0",
      "position": "right",
      "voice": "vo_luna_01.mp3"
    },
    {
      "type": "TEXT",
      "condition": "greeting == 2",
      "text": "You're the one Miki kept writing about, aren't you?",
      "profile": "123ccc:0",
      "position": "right",
      "voice": "vo_luna_01.mp3"
    },
    {
      "type": "STAGE",
      "actions": [
        { "action": "flash", "color": "#E6E0FF", "duration_ms": 600 },
        { "action": "show", "profile": "123bbb:1", "position": "far_right", "transition": "dissolve", "duration_ms": 900 }
      ]
    },
    {
      "type": "TEXT",
      "text": "{color=#B9A8FF}(She can't see me.{w=500} Please...{w} {wave}tell her.{/wave}){/color}",
      "profile": "123bbb:1"
    },
    {
      "type": "TEXT",
      "text": "{{NAME}}? Hello? Are you even list-{nw}",
      "profile": "123aaa:1"
    },
    {
      "type": "TEXT",
      "text": "...{w=300}{b}Who{/b} are you staring at?",
      "profile": "123aaa:1"
    },
    {
      "type": "CHOICE",
      "text": "What do you tell Luna?",
      "variable": "TOLD",
      "profile": "123ccc:0",
      "choices": [
        {
          "text": "Miki is sorry. She wanted you to know.",
          "value": "apology",
          "effects": [
            { "variable": "miki_trust", "op": "add", "value": 10 },
            { "variable": "luna_affection", "op": "add", "value": 10 }
          ]
        },
        {
          "text": "Nothing. It's not my place.",
          "value": "silent",
          "effects": [{ "variable": "miki_trust", "op": "subtract", "value": 5 }]
        },
        {
          "text": "[Show Luna's photo] She kept this.",
          "value": "photo",
          "condition": "has_cafe_photo == true",
          "effects": [
            { "variable": "miki_trust", "op": "add", "value": 10 },
            { "variable": "luna_affection", "op": "add", "value": 15 }
          ]
        }
      ]
    },
    {
      "type": "TEXT",
      "condition": "TOLD == 'silent'",
      "text": "...I see. Excuse me.",
      "profile": "123ccc:1"
    },
    {
      "type": "MEDIA",
      "condition": "TOLD != 'silent'",
      "media_type": "CG",
      "uri": "cg_luna_cafe.png",
      "caption": "For the first time in months, Luna smiles.",
      "unlock_id": "cg_luna_cafe"
    },
    {
      "type": "TEXT",
      "condition": "TOLD != 'silent'",
      "text": "We had a code for our diary. If you really talked to her, you'll know it.",
      "profile": "123ccc:2"
    },
    {
      "type": "INPUT",
      "condition": "TOLD != 'silent'",
      "text": "Luna slides a napkin over: \"Our year.\" (Did Miki mention one?)",
      "variable": "PASSCODE",
      "default_value": "????",
      "profile": "123ccc:0"
    },
    {
      "type": "TEXT",
      "condition": "PASSCODE == '2019'",
      "text": "...2019. Then you really did talk to her.",
      "profile": "123ccc:2",
      "effects": [{ "variable": "knows_passcode", "op": "set", "value": true }]
    },
    {
      "type": "TEXT",
      "condition": "TOLD != 'silent' && !knows_passcode",
      "text": "No... that's not it. But thank you for coming.",
      "profile": "123ccc:1"
    },
    { "type": "SET", "effects": [{ "variable": "bond", "op": "set", "expr": "miki_trust + luna_affection" }] },
    {
      "type": "NARRATION",
      "condition": "bond >= 25",
      "text": "For a moment the café is very quiet, as if someone just let out a long breath."
    },
    {
      "type": "BRANCH",
      "branches": [
        { "condition": "knows_passcode == true && luna_affection >= 15", "target": "ending_secret" },
        { "condition": "miki_trust >= 20", "target": "ending_true" },
        { "condition": "miki_trust >= 10", "target": "ending_good" }
      ],
      "fallback_target": "ending_bad"
    }
  ]
